# Supabase 24/7 Cloud Persistence
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-backend-api

# Official Retreat WhatsApp Desk Phone Number (without + symbol)
# Default is official Vanprastha Resorts number: 919650102777
NEXT_PUBLIC_WHATSAPP_PHONE=919650102777

# Optional: WhatsApp Cloud API / Webhook for automated instant lead notification
WHATSAPP_ALERT_WEBHOOK_URL=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
